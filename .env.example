# Copy this file to .env and fill in real values for your Supabase project.
# Never commit .env — it is git-ignored on purpose.

# ---------------------------------------------------------------------------
# Client-side (bundled into the browser build via Vite's `import.meta.env`)
# Safe to expose publicly. Protected by Supabase Row Level Security (RLS),
# not by secrecy of these values.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ---------------------------------------------------------------------------
# Server-side (read via `process.env` in server routes / server functions)
# ---------------------------------------------------------------------------

# Same values as above, used by server-rendered routes and middleware.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_PROJECT_ID="your-project-ref"

# SERVER-ONLY — SECRET. Bypasses Row Level Security entirely.
# Must NEVER be prefixed with VITE_, never referenced from client-bundled
# code, and never committed. Only load it inside *.server.ts modules /
# trusted server handlers. See src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
